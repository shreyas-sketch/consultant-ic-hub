# Copy to .env for local runs, or paste into each Railway service's Variables.
# Every value has a safe default for QA mode. Production refuses to boot with
# unsafe values (default SECRET_KEY, missing TOKEN_KEY, http APP_URL, localhost Mongo).
# ${{Service.VAR}} is Railway's reference syntax; replace with real values elsewhere.

# ---- Mode ----
QA_MODE=false                 # true = sample data, in-memory DB, every outside service faked
QA_SEED=true                  # QA only: load the demo practice on start
RUN_JOBS=false                # web: false. worker: true
ENVIRONMENT=production        # shows in logs and Sentry; defaults to Railway's environment name
# PORT is set by Railway. WEB_CONCURRENCY = uvicorn worker processes per web replica (default 2).
WEB_CONCURRENCY=2

# ---- Core ----
BRAND_NAME=Practice OS
APP_URL=https://app.example.in    # defaults to https://$RAILWAY_PUBLIC_DOMAIN when unset
CLIENT_DOMAIN=                    # client pages on <practice>.<CLIENT_DOMAIN>. Empty = /c/<practice> on APP_URL
SECRET_KEY=                       # 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_KEY=                        # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Database (MongoDB) ----
MONGO_URL=${{MongoDB.MONGO_URL}}  # Railway MongoDB service (private network), or an Atlas SRV URL
DB_NAME=practice_os
MONGO_MAX_POOL=50                 # per process. Total ≈ web replicas × WEB_CONCURRENCY × this + workers × this
MONGO_MIN_POOL=2
MONGO_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_READ_PREFERENCE=primary     # secondaryPreferred to send report reads to replicas (replica set only)
ENSURE_INDEXES_ON_START=true      # pre-deploy already builds them; true is a cheap safety net

# ---- Retention (days, enforced by TTL indexes) ----
RETAIN_JOB_RUNS_DAYS=30
RETAIN_VENDOR_LOG_DAYS=30
RETAIN_EVENTS_DAYS=90

# ---- Jobs (worker) ----
JOB_WS_CONCURRENCY=8              # workspaces processed at once by per-workspace jobs
JOB_AGENT_CONCURRENCY=4           # workspaces at once for scheduled AI agents

# ---- Our own team ----
ADMIN_PHONES=+919999999999        # comma-separated. These numbers get the Admin screen.
STAFF_EMAIL=
STAFF_PASSWORD=

# ---- AI ----
ANTHROPIC_API_KEY=
MODEL_SMALL=claude-haiku-5-5
MODEL_LARGE=claude-sonnet-5-5
LLM_MAX_CONCURRENCY=32
LLM_WAIT_SECONDS=15
# Prices in paise per million tokens (assumes about ₹85 per US$; check before launch)
PRICE_SMALL_IN=8500
PRICE_SMALL_OUT=42500
PRICE_LARGE_IN=25500
PRICE_LARGE_OUT=127500

# ---- Vendor switches: live | fake | off ----
VENDOR_AI=fake
VENDOR_WHATSAPP=fake
VENDOR_SMS=fake
VENDOR_EMAIL=fake
VENDOR_GMAIL=fake
VENDOR_OUTLOOK=fake
VENDOR_GCAL=fake
VENDOR_OUTLOOK_CAL=fake
VENDOR_MEET=fake
VENDOR_ZOOM=fake
VENDOR_MEETBOT=fake
VENDOR_ENRICH=fake
VENDOR_STORAGE=fake               # live = S3-compatible bucket (required with separate web + worker services)
VENDOR_DNS=fake

# ---- File storage ----
# Railway Storage Bucket / Cloudflare R2 / AWS S3 / MinIO. On Railway, reference the bucket's
# variables by its service name, e.g. S3_BUCKET=${{sorted-toybox.BUCKET}}, S3_ENDPOINT_URL=${{sorted-toybox.ENDPOINT}},
# S3_REGION=${{sorted-toybox.REGION}}, S3_ACCESS_KEY_ID=${{sorted-toybox.ACCESS_KEY_ID}},
# S3_SECRET_ACCESS_KEY=${{sorted-toybox.SECRET_ACCESS_KEY}}. Use BUCKET, not RAILWAY_BUCKET_NAME.
S3_BUCKET=
S3_ENDPOINT_URL=                  # empty for AWS; the bucket endpoint for Railway/R2/MinIO
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=virtual       # Railway buckets: virtual. "path" for MinIO and some other stores
UPLOAD_DIR=/data/uploads          # local storage path when VENDOR_STORAGE is not live

# ---- Vendor keys (only read when that vendor is live) ----
AISENSY_API_KEY=                  # WhatsApp
MSG91_AUTH_KEY=                   # SMS fallback for login codes
MSG91_TEMPLATE_ID=
EMAIL_API_URL=                    # transactional email HTTP endpoint (Postmark-style)
EMAIL_API_KEY=
EMAIL_FROM=notifications@example.in
INBOUND_DOMAIN=reply.example.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MEETBOT_API_URL=                  # meeting notetaker provider
MEETBOT_API_KEY=

# ---- Safety and observability ----
HOOK_SECRET=                      # required with live messaging; give providers <APP_URL>/api/hooks/<name>?secret=<HOOK_SECRET>
OTP_PER_IP_PER_HOUR=30
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true                     # JSON lines for Railway's log explorer
