# Copy to .env and fill in. Every value has a safe default for QA mode.

# ---- Mode ----
QA_MODE=false                 # true = sample data, in-memory DB, every outside service faked
QA_SEED=true                  # QA only: load the demo practice on start
RUN_JOBS=false                # web: false. worker: true (python worker.py sets the jobs going)
PORT=8000

# ---- Core ----
BRAND_NAME=Practice OS
APP_URL=https://app.example.in
CLIENT_DOMAIN=example.in      # client pages on <practice>.example.in. Empty = /c/<practice> on APP_URL
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
DB_NAME=practice_os
SECRET_KEY=                   # long random string. Signs login cookies.
TOKEN_KEY=                    # Fernet key for connected Gmail/Outlook/Zoom tokens:
                              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Our own team ----
ADMIN_PHONES=+919999999999    # comma-separated. These numbers get the Admin screen.
STAFF_EMAIL=
STAFF_PASSWORD=

# ---- AI ----
ANTHROPIC_API_KEY=
MODEL_SMALL=claude-haiku-5-5
MODEL_LARGE=claude-sonnet-5-5
LLM_MAX_CONCURRENCY=32
LLM_WAIT_SECONDS=15
# Prices in paise per million tokens (assumes about ₹85 per US$; check before launch)
PRICE_SMALL_IN=8500
PRICE_SMALL_OUT=42500
PRICE_LARGE_IN=25500
PRICE_LARGE_OUT=127500

# ---- Vendor switches: live | fake | off ----
VENDOR_AI=fake
VENDOR_WHATSAPP=fake
VENDOR_SMS=fake
VENDOR_EMAIL=fake
VENDOR_GMAIL=fake
VENDOR_OUTLOOK=fake
VENDOR_GCAL=fake
VENDOR_OUTLOOK_CAL=fake
VENDOR_MEET=fake
VENDOR_ZOOM=fake
VENDOR_MEETBOT=fake
VENDOR_ENRICH=fake
VENDOR_STORAGE=fake
VENDOR_DNS=fake

# ---- Vendor keys (only read when that vendor is live) ----
AISENSY_API_KEY=              # WhatsApp
MSG91_AUTH_KEY=               # SMS fallback for login codes
MSG91_TEMPLATE_ID=
EMAIL_API_URL=                # transactional email HTTP endpoint (Postmark-style)
EMAIL_API_KEY=
EMAIL_FROM=notifications@example.in
INBOUND_DOMAIN=reply.example.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MEETBOT_API_URL=              # meeting notetaker provider
MEETBOT_API_KEY=
S3_BUCKET=                    # plus the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION
UPLOAD_DIR=/data/uploads      # used when storage is not live

# ---- Safety ----
OTP_PER_IP_PER_HOUR=30
SENTRY_DSN=
