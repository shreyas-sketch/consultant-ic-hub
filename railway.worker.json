{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["backend/app/**", "backend/requirements.txt", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "python -m app.workers",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
